{
  "name": "garage-asani-glarus",
  "main": "server/worker.mjs",
  "compatibility_date": "2026-09-18",
  "workers_dev": true,
  "preview_urls": false,
  "upload_source_maps": false,
  "ratelimits": [
    {"name":"REQUEST_BURST", "namespace_id":"2026091901", "simple":{"limit":60,"period":10}},
    {"name":"REQUEST_SUSTAINED", "namespace_id":"2026091902", "simple":{"limit":300,"period":60}}
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "404-page"
  },
  "observability": {"enabled": false}
}
